---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavHeader from "@/components/sections/NavHeader.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import WhatIsFukuii from "@/components/sections/WhatIsFukuii.astro";
import WhyFukuii from "@/components/sections/WhyFukuii.astro";
import MiningSection from "@/components/sections/MiningSection.astro";
import InstitutionalSection from "@/components/sections/InstitutionalSection.astro";
import OperationsSection from "@/components/sections/OperationsSection.astro";
import NetworksSection from "@/components/sections/NetworksSection.astro";
import CTABannerSection from "@/components/sections/CTABannerSection.astro";
import FooterSection from "@/components/sections/FooterSection.astro";
---

<BaseLayout>
  <main>
    <NavHeader />
    <div id="main-content">
      <HeroSection />
      <WhatIsFukuii />
      <WhyFukuii />
      <MiningSection />
      <InstitutionalSection />
      <OperationsSection />
      <NetworksSection />
      <CTABannerSection />
    </div>
    <FooterSection />
  </main>
</BaseLayout>
