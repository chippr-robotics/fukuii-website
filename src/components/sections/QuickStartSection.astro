---
import FadeIn from "@/components/ui/FadeIn.astro";

const INSTALL_TABS = [
  { id: "linux", label: "Linux" },
  { id: "macos", label: "macOS" },
  { id: "windows", label: "Windows" },
  { id: "docker", label: "Docker" },
] as const;

const INSTALL_CODE: Record<string, string> = {
  linux: `# 1. Install JDK 25 LTS via SDKMAN
curl -s "https://get.sdkman.io" | bash
sdk install java 25-tem

# 2. Download the latest release
wget https://github.com/chippr-robotics/fukuii/releases/latest/download/fukuii-assembly-<ver>.jar

# 3. Verify
java -jar fukuii-assembly-<ver>.jar --version`,
  macos: `# 1. Install JDK 25 LTS via Homebrew
brew install openjdk@25
sudo ln -sfn $(brew --prefix)/opt/openjdk@25/libexec/openjdk.jdk /Library/Java/JavaVirtualMachines/openjdk-25.jdk

# 2. Download the latest release
curl -LO https://github.com/chippr-robotics/fukuii/releases/latest/download/fukuii-assembly-<ver>.jar

# 3. Verify
java -jar fukuii-assembly-<ver>.jar --version`,
  windows: `# 1. Install JDK 25 LTS via winget (run PowerShell as Administrator)
winget install Microsoft.OpenJDK.25

# 2. Download the latest release
Invoke-WebRequest \`
  -Uri "https://github.com/chippr-robotics/fukuii/releases/latest/download/fukuii-assembly-<ver>.jar" \`
  -OutFile fukuii.jar

# 3. Verify
java -jar fukuii.jar --version`,
  docker: `# No JDK required, the image bundles everything
docker pull ghcr.io/chippr-robotics/fukuii:latest

# Verify
docker run ghcr.io/chippr-robotics/fukuii:latest --version`,
};

const SOURCE_BUILD_CODE = `# Requires JDK 25 LTS + sbt (Scala build tool)
git clone https://github.com/chippr-robotics/fukuii
cd fukuii && sbt assembly
# Output: target/fukuii-assembly-<ver>.jar`;

const NETWORKS = [
  { name: "Ethereum Classic", arg: "etc", consensus: "PoW", chainId: "61" },
  { name: "Mordor", arg: "mordor", consensus: "PoW testnet", chainId: "63" },
  { name: "Ethereum mainnet", arg: "eth", consensus: "PoS (needs a CL)", chainId: "1" },
  { name: "Sepolia", arg: "sepolia", consensus: "PoS testnet (needs a CL)", chainId: "11155111" },
] as const;

const NEXT_STEPS = [
  { title: "Run a validator (PoS)", body: "Pair a consensus client, enable the Engine API with a JWT secret. Mainnet staking requires 32 ETH.", href: "https://docs.fukuii.com/validator" },
  { title: "Mine (PoW)", body: "Configure a coinbase address and connect a miner. Applies to Ethereum Classic and Mordor.", href: "https://docs.fukuii.com/mining" },
  { title: "Archive node", body: "Full history retained. See hardware tiers below for disk sizing.", href: "https://docs.fukuii.com/archive" },
  { title: "Run as a service", body: "Keep the node running under systemd (Linux), launchd (macOS), or a Windows Service.", href: "https://docs.fukuii.com/service" },
] as const;

const REQUIREMENTS = [
  { tier: "Home node", ram: "8 GB", disk: "500 GB" },
  { tier: "Professional", ram: "16 GB", disk: "1 TB" },
  { tier: "Enterprise", ram: "32–64 GB", disk: "2–4 TB" },
  { tier: "Archive", ram: "64 GB+", disk: "4 TB+" },
] as const;
---

<section class="section-fk" id="quickstart">
  <div class="container-fk">
    <FadeIn>
      <div style="margin-bottom: 2.5rem;">
        <h2 class="section-title" style="margin-bottom: 0.75rem;">Quick Start</h2>
        <p class="section-subtitle">
          Test on Mordor testnet, deploy via Cosign-signed Docker images on GHCR, or pair with any
          consensus client for Ethereum Sepolia, all from the same binary. The node self-reports
          its build version, commit hash, and build provenance at{" "}
          <code style="font-family: var(--font-mono); font-size: 0.9em;">/buildinfo</code>.
          Requires JDK 25 LTS.
        </p>
      </div>
    </FadeIn>

    <FadeIn delay={80}>
      <pre class="code-block"><code>docker run ghcr.io/chippr-robotics/fukuii mordor</code></pre>
    </FadeIn>

    <FadeIn delay={120}>
      <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin-top: 1.25rem;">
        From an 8 GB home node to a 64 GB+ archive node, the same binary scales from solo operator
        to institutional deployment.
      </p>
    </FadeIn>

    <FadeIn delay={160}>
      <div style="margin-top: 3.5rem;">
        <span class="cell-label">Layer 1: Install</span>
        <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin-top: 0.5rem; margin-bottom: 1.5rem;">
          Get the binary onto your machine. Native installs require JDK 25 LTS; the Docker image
          bundles everything.
        </p>

        <div class="install-tabs" style="display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 0;">
          {
            INSTALL_TABS.map((tab, i) => (
              <button class="tab-btn install-tab" class:list={[i === 0 && "tab-active"]} data-tab={tab.id}>
                {tab.label}
              </button>
            ))
          }
        </div>

        <div class="code-block" style="border: 1px solid var(--border); border-top: none; border-radius: 0;">
          {
            INSTALL_TABS.map((tab, i) => (
              <pre
                class="install-panel"
                data-panel={tab.id}
                style={{ display: i === 0 ? "block" : "none", margin: 0, fontFamily: "var(--font-mono)", fontSize: "0.8125rem", lineHeight: 1.7, color: "var(--text)", padding: "1.5rem", overflowX: "auto", whiteSpace: "pre" }}
              >
                {INSTALL_CODE[tab.id]}
              </pre>
            ))
          }
        </div>

        <details style="margin-top: 1rem; border: 1px solid var(--border);">
          <summary style="padding: 0.75rem 1.25rem; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; color: var(--text-subtle); cursor: pointer; list-style: none; user-select: none;">
            ▶ Build from source (advanced, requires Scala toolchain)
          </summary>
          <div class="code-block" style="border: none; border-top: 1px solid var(--border); border-radius: 0;">
            <pre style="margin: 0; font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.7; color: var(--text); padding: 1.5rem; overflow-x: auto; white-space: pre;">{SOURCE_BUILD_CODE}</pre>
          </div>
        </details>
      </div>
    </FadeIn>

    <FadeIn delay={80}>
      <div style="margin-top: 3.5rem;">
        <span class="cell-label">Layer 2: Run a node</span>
        <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin-top: 0.5rem; margin-bottom: 1.5rem;">
          Once installed, the network is a single argument. The same binary runs every network
          below.
        </p>

        <div style="border: 1px solid var(--border); overflow: hidden;">
          <div style="display: grid; grid-template-columns: 1.5fr 1fr 2fr 1fr; background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 0.625rem 1.25rem;">
            {
              ["Network", "Argument", "Consensus", "Chain ID"].map((col) => (
                <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-subtle);">{col}</span>
              ))
            }
          </div>
          {
            NETWORKS.map((row, i) => (
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "1.5fr 1fr 2fr 1fr",
                  padding: "0.75rem 1.25rem",
                  borderBottom: i < NETWORKS.length - 1 ? "1px solid var(--border)" : "none",
                  background: i % 2 === 0 ? "transparent" : "var(--bg-card)",
                }}
              >
                <span style="font-size: 0.875rem; font-weight: 600; color: var(--text);">{row.name}</span>
                <code style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--accent);">{row.arg}</code>
                <span style="font-size: 0.875rem; color: var(--text-muted);">{row.consensus}</span>
                <span style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-muted);">{row.chainId}</span>
              </div>
            ))
          }
        </div>

        <div class="code-block" style="border: 1px solid var(--border); border-top: none; border-radius: 0;">
          <pre style="margin: 0; font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.7; color: var(--text); padding: 1.5rem; overflow-x: auto; white-space: pre;">{`# Native\njava -jar fukuii-assembly-<ver>.jar <network>\n\n# Docker\ndocker run -v fukuii-data:/var/lib/fukuii \\\n  ghcr.io/chippr-robotics/fukuii:latest <network>`}</pre>
        </div>

        <p style="font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.875rem;">
          Proof-of-Stake networks require a paired consensus client. See Next steps below.
        </p>
      </div>
    </FadeIn>

    <FadeIn delay={80}>
      <div style="margin-top: 3.5rem;">
        <span class="cell-label">Next steps</span>
        <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin-top: 0.5rem; margin-bottom: 1.5rem;">
          A syncing full node is the default. These add a role on top of it. Mining applies to
          Proof-of-Work networks; validating applies to Proof-of-Stake networks.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
          {
            NEXT_STEPS.map((card) => (
              <a href={card.href} target="_blank" rel="noopener noreferrer" class="card-fk" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.5rem; text-decoration: none;">
                <div>
                  <h3 style="font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.375rem; letter-spacing: -0.01em;">{card.title}</h3>
                  <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.55;">{card.body}</p>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; color: var(--text-subtle); margin-top: 2px;" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </FadeIn>

    <FadeIn delay={80}>
      <div style="margin-top: 3.5rem;">
        <span class="cell-label">Hardware requirements</span>
        <div style="border: 1px solid var(--border); overflow: hidden; margin-top: 1rem;">
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 0.625rem 1.25rem;">
            {
              ["Tier", "RAM", "Disk"].map((col) => (
                <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-subtle);">{col}</span>
              ))
            }
          </div>
          {
            REQUIREMENTS.map((row, i) => (
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "1fr 1fr 1fr",
                  padding: "0.75rem 1.25rem",
                  borderBottom: i < REQUIREMENTS.length - 1 ? "1px solid var(--border)" : "none",
                  background: i % 2 === 0 ? "transparent" : "var(--bg-card)",
                }}
              >
                <span style="font-size: 0.875rem; font-weight: 600; color: var(--text);">{row.tier}</span>
                <span style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-muted);">{row.ram}</span>
                <span style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-muted);">{row.disk}</span>
              </div>
            ))
          }
        </div>
      </div>
    </FadeIn>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".install-tabs").forEach((tabBar) => {
    const container = tabBar.parentElement;
    if (!container) return;

    tabBar.querySelectorAll<HTMLButtonElement>(".install-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.tab;
        tabBar.querySelectorAll(".install-tab").forEach((b) => b.classList.remove("tab-active"));
        btn.classList.add("tab-active");
        container.querySelectorAll<HTMLElement>(".install-panel").forEach((panel) => {
          panel.style.display = panel.dataset.panel === target ? "block" : "none";
        });
      });
    });
  });
</script>
