---
const COLS = [
  {
    heading: "Product",
    links: [
      { label: "What is Fukuii?", href: "/#what" },
      { label: "Features", href: "/features" },
      { label: "Stack", href: "/stack" },
      { label: "Architecture", href: "/architecture" },
      { label: "Networks", href: "/#networks" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Download", href: "https://github.com/chippr-robotics/fukuii/releases", external: true },
      { label: "Quick Start", href: "/guide" },
      { label: "Documentation", href: "https://docs.fukuii.com", external: true },
      { label: "GitHub", href: "https://github.com/chippr-robotics/fukuii", external: true },
      { label: "Docker", href: "https://ghcr.io/chippr-robotics/fukuii", external: true },
    ],
  },
] as const;
---

<footer style="border-top: 1px solid var(--border); background: var(--bg-elev); padding: 3.5rem 0 2rem;">
  <div class="container-fk">
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 3rem; margin-bottom: 3rem; justify-items: center; text-align: center;">
      <div>
        <p style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-subtle); margin-bottom: 0.875rem;">
          {COLS[0].heading}
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; align-items: center;">
          {
            COLS[0].links.map((link) => (
              <li>
                <a
                  class="footer-link"
                  href={link.href}
                  target={"external" in link && link.external ? "_blank" : undefined}
                  rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <a href="/" style="display: flex; justify-content: center; text-decoration: none; margin-bottom: 0.875rem;">
          <img src="/fukuii-hex-logo.png" alt="Fukuii" width="120" height="120" />
        </a>
        <p style="font-size: 0.8125rem; color: var(--text-subtle); line-height: 1.65; max-width: 28ch; margin-inline: auto;">
          Fukuii is a Scala execution client for Ethereum and the EVM ecosystem. Feature-complete,
          signed and SBOM-verifiable, open source.
        </p>
      </div>

      <div>
        <p style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-subtle); margin-bottom: 0.875rem;">
          {COLS[1].heading}
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; align-items: center;">
          {
            COLS[1].links.map((link) => (
              <li>
                <a
                  class="footer-link"
                  href={link.href}
                  target={"external" in link && link.external ? "_blank" : undefined}
                  rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div style="border-top: 1px solid var(--border); padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; justify-content: space-between;">
      <p style="font-size: 0.75rem; color: var(--text-subtle);">© 2026 Chippr Robotics LLC · Apache 2.0 · Forked from Mantis (IOHK)</p>
      <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-subtle); letter-spacing: 0.04em;">package com.chipprbots</p>
    </div>
  </div>
</footer>
