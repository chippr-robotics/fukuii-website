---

<section id="hero" style="position: relative; overflow: hidden; border-bottom: 1px solid var(--border);">
  <HexCanvas />
  <div class="container-fk" style="position: relative; z-index: 1;">
    <div class="cell-grid-2col" style="border: 1px solid var(--border);">
      <div
        class="hero-cell-overlay"
        style="position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 2.5rem; min-height: 520px; text-align: center;"
      >
        <img src="/fukuii-hex-logo.svg" alt="" width="320" height="320" aria-hidden="true" style="margin-top: 2rem;" />

        <p style="font-size: clamp(1.375rem, 3vw, 2rem); font-weight: 700; color: var(--text); line-height: 1.2; letter-spacing: -0.02em; text-align: center; width: 100%; padding: 0 1.25rem; margin-top: 1.5rem;">
          AN <span style="color: var(--accent);">EXECUTION CLIENT</span><br />BUILT FOR GLOBAL FINANCE
        </p>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: auto; padding-top: 2rem; width: 100%;">
          <a
            href="https://github.com/chippr-robotics/fukuii/releases"
            target="_blank"
            rel="noopener noreferrer"
            style="background: var(--accent); color: #fff; border: 1px solid var(--accent); padding: 0.75rem 1.75rem; font-weight: 700; font-size: 0.9375rem; text-decoration: none; font-family: var(--font-sans);"
          >
            Download Fukuii
          </a>
        </div>

        <div class="os-platform-row" style="justify-content: center; margin-block: 1rem 0;">
          {
            PLATFORMS.map((p) => (
              <span class="os-pill">
                <svg aria-hidden="true" style="width: 16px; height: 16px; flex-shrink: 0;" viewBox={p.viewBox} fill="currentColor">
                  <path d={p.path} />
                </svg>
                {p.label}
              </span>
            ))
          }
        </div>
      </div>

      <div
        class="hero-cell-overlay"
        style="position: relative; padding: 2.5rem clamp(2rem, 4vw, 3.5rem); display: flex; flex-direction: column; justify-content: flex-start; border-left: 1px solid var(--border);"
      >
        <div class="badge-fk badge-gold" style="position: absolute; top: 1.25rem; left: clamp(2rem, 4vw, 3.5rem);">
          <span class="badge-pulse-dot"></span>
          Beta
        </div>

        <div style="margin: auto 0; display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="text-align: center;">
            <div style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: 0.22em; color: var(--text); line-height: 1.1;">
              FUKUII
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-subtle); margin-top: 0.375rem;">
              Ethereum Virtual Machine Client
            </div>
          </div>

          <p style="font-size: clamp(0.9375rem, 1.2vw + 0.5rem, 1.0625rem); color: var(--text-muted); line-height: 1.7; max-width: 52ch;">
            Fukuii is a Scala execution client for the wider Ethereum Virtual Machine ecosystem.
            It is feature-complete, with native support for established EVM execution
            configurations and consensus models. Built with intention, Fukuii is designed to serve
            institutional digital custodians, global financial institutions, and sovereign wealth
            funds, while remaining lightweight enough for the solo operator. Because it runs on
            the JVM, its stack aligns natively with the infrastructure of modern finance: the
            trading desks, clearing systems, and settlement layers already built there.
          </p>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: auto; padding-top: 2rem; justify-content: center;">
          <a
            href="/guide"
            style="border: 1px solid var(--border-strong); color: var(--text-muted); padding: 0.75rem 1.75rem; font-weight: 600; font-size: 0.9375rem; text-decoration: none; font-family: var(--font-sans);"
          >
            Quick Start
          </a>
        </div>

        <TechStackBadges />
      </div>
    </div>
  </div>
</section>
