---
import FadeIn from "@/components/ui/FadeIn.astro";

const CARDS = [
  {
    title: "No FFI bridge, no second stack",
    lead: "The same runtime your trading systems already run on.",
    proof: "Pure JVM architecture end to end — no foreign-language bridge between the chain and the rest of the stack",
    kind: "stack",
  },
  {
    title: "Prove what you deployed",
    lead: "Auditable by construction.",
    proof: "The same signed-image and SBOM discipline that regulated audit and compliance frameworks require",
    kind: "shield",
  },
  {
    title: "One audited binary, every network",
    lead: "Fewer systems to secure and staff for.",
    proof: "Concurrent multi-instance execution runs every network from one binary instead of a growing fleet, with external-signer/HSM custody built in",
    kind: "grid",
  },
] as const;
---

<section class="section-fk" id="institutional" style="background: var(--bg-elev);">
  <div class="container-fk">
    <FadeIn>
      <div style="margin-bottom: 3rem;">
        <span class="cell-label">Regulated Finance</span>
        <h2 class="section-title" style="margin-bottom: 1rem;">Built to finance&apos;s standard.</h2>
        <p class="section-subtitle">
          The trading systems and custody platforms already running JVM infrastructure need
          blockchain infrastructure that fits the same runtime and the same audit standards — not
          a second, foreign-language stack to secure and staff for. Fukuii is pure JVM-native
          infrastructure, filling the position Besu vacated when it exited Ethereum Classic
          support.
        </p>
      </div>
    </FadeIn>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; margin-bottom: 1px; border: 1px solid var(--border);">
      {
        CARDS.map((card, i) => (
          <FadeIn delay={i * 100}>
            <div class="cell-fk" style={{ padding: "1.75rem", height: "100%", border: "none", borderRight: i < CARDS.length - 1 ? "1px solid var(--border)" : undefined }}>
              <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--accent-soft); display: flex; align-items: center; justify-content: center; color: var(--accent); margin-bottom: 1.125rem; flex-shrink: 0;">
                {card.kind === "stack" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="1.5" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="8" y1="4" x2="8" y2="9" />
                  </svg>
                )}
                {card.kind === "shield" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <polyline points="9 12 11 14 15 10" />
                  </svg>
                )}
                {card.kind === "grid" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="4" width="7" height="7" rx="1" />
                    <rect x="13" y="4" width="7" height="7" rx="1" />
                    <rect x="4" y="13" width="7" height="7" rx="1" />
                    <rect x="13" y="13" width="7" height="7" rx="1" />
                  </svg>
                )}
              </div>
              <h3 style="font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.375rem; letter-spacing: -0.01em;">{card.title}</h3>
              <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55; margin-bottom: 0.875rem;">{card.lead}</p>
              <p style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-subtle); line-height: 1.55;">{card.proof}</p>
            </div>
          </FadeIn>
        ))
      }
    </div>

    <FadeIn delay={300}>
      <div class="cell-fk" style="border-left: 3px solid var(--accent); padding: 1.25rem 2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; flex: 1; min-width: 22ch;">
          Signed images, provenance attestation, and a per-release SBOM are already proven — see
          the full supply-chain posture.
        </p>
        <a
          href="#operations"
          style="font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; color: var(--accent); text-decoration: none; white-space: nowrap; flex-shrink: 0;"
        >
          Security & supply chain →
        </a>
      </div>
    </FadeIn>
  </div>
</section>
