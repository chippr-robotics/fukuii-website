---
import FadeIn from "@/components/ui/FadeIn.astro";

const CARDS = [
  {
    title: "Observability built in",
    lead: "Know what the node is doing.",
    items: [
      "Prometheus metrics + Grafana dashboards",
      "/health · /readiness · /buildinfo endpoints",
      "ResilientRollingFileAppender for disk pressure",
    ],
    kind: "bars",
  },
  {
    title: "Predictable under load",
    lead: "Sync doesn't starve the RPC.",
    items: [
      "3 isolated Pekko dispatchers (sync, rpc, general)",
      "Bootstrap checkpoints skip startup peer-wait",
      "Log rotation survives disk pressure",
    ],
    kind: "clock",
  },
  {
    title: "Verifiable supply chain",
    lead: "Verify what you deploy.",
    items: ["Cosign-signed container images on GHCR", "Build provenance attestation", "CycloneDX SBOM on every release"],
    kind: "shield",
  },
  {
    title: "Built for aggregation gateways",
    lead: "A clean upstream, not five copies of the same client.",
    items: ["dRPC-Provider gRPC bridge", "A named RPC-relay deployment profile", "An independent implementation behind the aggregation layer"],
    kind: "hub",
  },
] as const;
---

<section class="section-fk" id="operations" style="background: var(--bg-elev);">
  <div class="container-fk">
    <FadeIn>
      <div style="margin-bottom: 3rem;">
        <span class="cell-label">Operations</span>
        <h2 class="section-title" style="margin-bottom: 1rem;">Designed for the people who run it.</h2>
        <p class="section-subtitle">
          Three isolated Pekko dispatchers keep sync pressure from starving the RPC, so the node
          stays responsive under full-load SNAP sync. Cosign-signed images, build provenance
          attestation, and a CycloneDX SBOM on every release mean you know exactly what you
          deployed and can prove it to anyone who asks. Prometheus metrics, Grafana dashboards,
          and liveness endpoints are built in, no sidecar, no plugin, no configuration required.
        </p>
      </div>
    </FadeIn>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; margin-bottom: 1px; border: 1px solid var(--border);">
      {
        CARDS.map((card, i) => (
          <FadeIn delay={i * 100}>
            <div class="cell-fk" style={{ padding: "1.75rem", height: "100%", border: "none", borderRight: i < CARDS.length - 1 ? "1px solid var(--border)" : undefined }}>
              <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--accent-soft); display: flex; align-items: center; justify-content: center; color: var(--accent); margin-bottom: 1.125rem; flex-shrink: 0;">
                {card.kind === "bars" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                  </svg>
                )}
                {card.kind === "clock" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                )}
                {card.kind === "shield" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <polyline points="9 12 11 14 15 10" />
                  </svg>
                )}
                {card.kind === "hub" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="5" cy="12" r="2.5" />
                    <circle cx="19" cy="5" r="2.5" />
                    <circle cx="19" cy="12" r="2.5" />
                    <circle cx="19" cy="19" r="2.5" />
                    <line x1="7.3" y1="12" x2="16.7" y2="6.3" />
                    <line x1="7.3" y1="12" x2="16.7" y2="12" />
                    <line x1="7.3" y1="12" x2="16.7" y2="17.7" />
                  </svg>
                )}
              </div>
              <h3 style="font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.375rem; letter-spacing: -0.01em;">{card.title}</h3>
              <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55;">{card.lead}</p>
              <div style="display: flex; flex-direction: column; gap: 0.375rem; margin-top: 0.875rem;">
                {
                  card.items.map((item) => (
                    <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
                      <span style="color: var(--accent); flex-shrink: 0; margin-top: 0.05em; font-weight: 700; font-size: 0.875rem; line-height: 1.5;" aria-hidden="true">
                        ✓
                      </span>
                      <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); line-height: 1.55;">{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </FadeIn>
        ))
      }
    </div>

    <FadeIn delay={300}>
      <div class="cell-fk" style="border-left: 3px solid var(--accent); padding: 1.25rem 2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; flex: 1; min-width: 22ch;">
          Runbooks, alerting guidance, and upgrade procedures live in the operator documentation.
        </p>
        <a
          href="https://docs.fukuii.com"
          target="_blank"
          rel="noopener noreferrer"
          style="font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; color: var(--accent); text-decoration: none; white-space: nowrap; flex-shrink: 0;"
        >
          Operator docs →
        </a>
      </div>
    </FadeIn>
  </div>
</section>
