---
import FadeIn from "@/components/ui/FadeIn.astro";
---

<section class="section-fk" id="features" style="background: var(--bg-elev);">
  <div class="container-fk">
    <FadeIn>
      <div style="border: 1px solid var(--border); padding: 1.75rem 2.5rem;">
        <span class="cell-label">Features</span>
        <h2 class="section-title" style="margin-bottom: 0.75rem;">Built to the EVM standard.</h2>
        <p class="section-subtitle">
          Implements the same open wire protocols, sync strategy, and Engine API as every other
          EVM client — verified byte-exact against the public specification.
        </p>
      </div>
    </FadeIn>
  </div>
</section>
