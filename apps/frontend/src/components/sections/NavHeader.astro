---
import ThemeToggle from "@/components/ui/ThemeToggle.astro";

const NAV_LINKS = [
  { label: "About", href: "/#what" },
  { label: "Features", href: "/features" },
  { label: "Networks", href: "/#networks" },
  { label: "Quick Start", href: "/guide" },
  { label: "Docs", href: "https://docs.fukuii.com", external: true },
] as const;
---

<header class="nav-fk">
  <div class="container-fk">
    <div style="display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 1rem;">
      <a href="/" style="display: flex; align-items: center; gap: 0.625rem; text-decoration: none; flex-shrink: 0;">
        <div style="display: flex; flex-direction: column; gap: 0.1rem;">
          <span style="font-family: var(--font-sans); font-weight: 700; font-size: 1.0625rem; letter-spacing: 0.06em; color: var(--text); line-height: 1.2;">
            FUKUII
          </span>
          <span style="font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-subtle); line-height: 1;">
            Ethereum Virtual Machine Client
          </span>
        </div>
      </a>

      <nav class="hidden md:flex" style="gap: 0.25rem; align-items: center;">
        {
          NAV_LINKS.map((link) => (
            <a
              class="nav-link"
              href={link.href}
              target={"external" in link && link.external ? "_blank" : undefined}
              rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div style="display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0;">
        <ThemeToggle />
        <a
          href="https://github.com/chippr-robotics/fukuii"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-github-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>

        <button
          class="icon-btn flex md:hidden mobile-nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="mobile-nav-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg class="mobile-nav-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display: none;">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-nav-panel" style="display: none; border-top: 1px solid var(--border); padding-block: 0.75rem; flex-direction: column; gap: 0.25rem;">
      {
        NAV_LINKS.map((link) => (
          <a
            class="nav-link"
            href={link.href}
            target={"external" in link && link.external ? "_blank" : undefined}
            rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
            style="padding: 0.625rem 0.75rem; font-size: 0.9375rem; display: block;"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".mobile-nav-toggle");
  const panel = document.querySelector<HTMLElement>(".mobile-nav-panel");
  const openIcon = document.querySelector<HTMLElement>(".mobile-nav-icon-open");
  const closeIcon = document.querySelector<HTMLElement>(".mobile-nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.style.display === "flex";
    if (panel) panel.style.display = isOpen ? "none" : "flex";
    if (openIcon) openIcon.style.display = isOpen ? "block" : "none";
    if (closeIcon) closeIcon.style.display = isOpen ? "none" : "block";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
  });

  panel?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      panel.style.display = "none";
      if (openIcon) openIcon.style.display = "block";
      if (closeIcon) closeIcon.style.display = "none";
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
