---
---

<button
  class="icon-btn theme-toggle"
  aria-label="Switch theme"
  title="Switch theme"
>
  <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <line x1="12" y1="2" x2="12" y2="6" />
    <line x1="12" y1="18" x2="12" y2="22" />
    <line x1="4.93" y1="4.93" x2="7.76" y2="7.76" />
    <line x1="16.24" y1="16.24" x2="19.07" y2="19.07" />
    <line x1="2" y1="12" x2="6" y2="12" />
    <line x1="18" y1="12" x2="22" y2="12" />
    <line x1="4.93" y1="19.07" x2="7.76" y2="16.24" />
    <line x1="16.24" y1="7.76" x2="19.07" y2="4.93" />
  </svg>
  <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  type Theme = "dark" | "light";

  function currentTheme(): Theme {
    const stored = localStorage.getItem("fk-theme");
    return stored === "light" ? "light" : "dark";
  }

  function applyIcon(button: HTMLElement, theme: Theme) {
    const sun = button.querySelector<HTMLElement>(".theme-toggle-sun");
    const moon = button.querySelector<HTMLElement>(".theme-toggle-moon");
    if (sun) sun.style.display = theme === "dark" ? "block" : "none";
    if (moon) moon.style.display = theme === "dark" ? "none" : "block";
    button.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    button.setAttribute("title", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
  }

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
    applyIcon(button, currentTheme());

    button.addEventListener("click", () => {
      const next: Theme = currentTheme() === "dark" ? "light" : "dark";
      localStorage.setItem("fk-theme", next);
      document.documentElement.setAttribute("data-theme", next);
      document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((b) => applyIcon(b, next));
    });
  });
</script>
